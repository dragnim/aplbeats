{
  "name": "apl-beats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A generative rhythm machine powered by APL.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dragnim/aplbeats.git"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshot": "node scripts/screenshot.mjs",
    "measure:kit": "node scripts/measure-kit.mjs",
    "measure:kits": "node scripts/measure-kits.mjs",
    "diagnose:reference": "node scripts/diagnose-reference.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:apl-live": "tsx scripts/verify-apl-live.ts",
    "verify:apl-generators-live": "tsx scripts/verify-apl-generators-live.ts",
    "spike:apl-rl": "tsx scripts/spike-rl-live.ts",
    "verify:credits": "node scripts/verify-credits.mjs",
    "import:samples": "node scripts/import-samples.mjs",
    "render:tr909": "node scripts/render-tr909.mjs",
    "review:patterns": "tsx scripts/review-patterns.ts",
    "review:transforms": "tsx scripts/review-transforms.ts",
    "review:apl-generators": "tsx scripts/review-apl-generators.ts",
    "review:layout": "node scripts/review-layout.mjs",
    "measure:generated": "node scripts/measure-generated.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
